{
  "name": "Steward",
  "short_name": "Steward",
  "description": "Tasks, notes and calendar in one place.",
  "start_url": "./",
  "scope": "./",
  "id": "./",
  "display": "standalone",
  "background_color": "#f6f1e5",
  "theme_color": "#f6f1e5",
  "icons": [
    {
      "src": "icons/icon-192.png?v=4.3.1",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png?v=4.3.1",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/icon-maskable-512.png?v=4.3.1",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Add task",
      "short_name": "Add task",
      "url": "./#/add",
      "icons": [
        {
          "src": "icons/icon-192.png?v=4.3.1",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Today",
      "url": "./#/today"
    },
    {
      "name": "New note",
      "url": "./#/notes"
    },
    {
      "name": "Calendar",
      "url": "./#/calendar"
    }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "application/pdf",
            "audio/*",
            "video/*",
            "text/*",
            "*/*"
          ]
        }
      ]
    }
  }
}
